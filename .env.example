# Polygon RPC endpoint from Alchemy, Infura, QuickNode, or another provider.
POLYGON_RPC_URL=https://polygon-rpc.com

# Dedicated deployment wallet private key.
# Never commit a real private key. Keep only enough MATIC for deployment gas.
DEPLOYER_PRIVATE_KEY=replace_with_deployment_wallet_private_key

# Wallet that receives the full initial IRAN supply.
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Used after deployment by `npm run update:site:contract`.
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_DECIMALS=18
CONTRACT_VERIFIED=false
PUBLIC_SITE_URL=
